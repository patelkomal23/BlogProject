<%- include('../partials/header.ejs') %>

<style>
  /* Card Design */
  .blog-form-card {
    border-radius: 18px;
    padding: 25px;
    background: #ffffff;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    transition: 0.3s;
    border: none;
  }

  .blog-form-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  }

  /* Title */
  .form-title {
    font-size: 24px;
    font-weight: 700;
    color: #333;
    margin-bottom: 15px;
  }

  /* Inputs */
  .styled-input,
  textarea {
    border-radius: 10px !important;
    padding: 10px 15px !important;
    border: 1px solid #ccc !important;
    transition: 0.3s ease;
  }

  .styled-input:focus,
  textarea:focus {
    border-color: #4e73df !important;
    box-shadow: 0 0 5px rgba(78,115,223,0.4);
  }

  /* Labels */
  .styled-label {
    font-size: 14px;
    font-weight: 600;
    color: #444;
  }

  /* Submit Button */
  .submit-btn {
    background: #4e73df;
    border: none;
    font-size: 16px;
    padding: 10px 25px;
    border-radius: 8px;
    transition: 0.3s;
  }

  .submit-btn:hover {
    background: #3a5cc9;
  }

  /* Image Preview */
  #previewImg {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 10px;
    display: block;
    margin-bottom: 10px;
    border: 1px solid #eee;
  }
</style>

<div class="page-wrapper">

  <!-- Breadcrumb -->
  <div class="page-breadcrumb">
    <div class="row">
      <div class="col-12 d-flex no-block align-items-center">
        <h4 class="page-title">Update Blog</h4>
      </div>
    </div>
  </div>

  <!-- Content -->
  <div class="container-fluid mt-4">
    <div class="row justify-content-start">
      <div class="col-md-7">

        <div class="card blog-form-card">

          <form class="form-horizontal" method="post" action="/update-blog/<%= blog.id %>" enctype="multipart/form-data">

            <h3 class="form-title">Edit Blog Details</h3>

            <!-- Blog Image Preview -->
            <!-- <img id="previewImg" src="/uploads/<%= blog.image %>" alt="Blog Image"> -->

            <!-- File Input -->
            <div class="form-group row mb-4">
              <label class="col-sm-4 col-form-label styled-label">Change Blog Image</label>
              <div class="col-sm-8">
                <input type="file" class="form-control styled-input" id="imageUpload" name="image">
              </div>
            </div>

            <!-- Title -->
            <div class="form-group row mb-4">
              <label class="col-sm-4 col-form-label styled-label">Blog Title</label>
              <div class="col-sm-8">
                <input type="text" name="title" class="form-control styled-input"
                       value="<%= blog.title %>" placeholder="Enter title">
              </div>
            </div>

            <!-- Category -->
            <div class="form-group row mb-4">
              <label class="col-sm-4 col-form-label styled-label">Category</label>
              <div class="col-sm-8">
                <input type="text" name="category" class="form-control styled-input"
                       value="<%= blog.category %>" placeholder="Enter category">
              </div>
            </div>

            <!-- Description -->
            <div class="form-group row mb-4">
              <label class="col-sm-4 col-form-label styled-label">Description</label>
              <div class="col-sm-8">
                <textarea name="description" rows="5"
                          class="form-control styled-input"><%= blog.description %></textarea>
              </div>
            </div>

            <!-- Submit -->
            <div class="text-center mt-3">
              <button type="submit" class="btn btn-primary submit-btn">Update Blog</button>
            </div>

          </form>

        </div>

      </div>
    </div>
  </div>

</div>

<script>
  // Live Image Preview
  document.getElementById("imageUpload").addEventListener("change", function(){
    const file = this.files[0];
    if (file){
      const reader = new FileReader();
      reader.onload = function(e){
        document.getElementById("previewImg").src = e.target.result;
      }
      reader.readAsDataURL(file);
    }
  });
</script>

<%- include('../partials/footer.ejs') %>
