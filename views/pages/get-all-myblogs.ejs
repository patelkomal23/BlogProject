<%- include('../partials/header.ejs') %>
      <!-- ============================================================== -->
      <!-- End Left Sidebar - style you can find in sidebar.scss  -->
      <!-- ============================================================== -->
      <!-- ============================================================== -->
      <!-- Page wrapper  -->
      <!-- ============================================================== -->
      <div class="page-wrapper">
        <!-- ============================================================== -->
        <!-- Bread crumb and right sidebar toggle -->
        <!-- ============================================================== -->
        <div class="page-breadcrumb">
          <div class="row">
            <div class="col-12 d-flex no-block align-items-center">
              <h4 class="page-title">Tables</h4>
              <div class="ms-auto text-end">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">
                      Library
                    </li>
                  </ol>
                </nav>
              </div>
            </div>
          </div>
        </div>
        <!-- ============================================================== -->
        <!-- End Bread crumb and right sidebar toggle -->
        <!-- ============================================================== -->
        <!-- ============================================================== -->
        <!-- Container fluid  -->
        <!-- ============================================================== -->
        <div class="container-fluid">
          <!-- ============================================================== -->
          <!-- Start Page Content -->
          <!-- ============================================================== -->
          <div class="row">
            <div class="row">
              <% blogs.forEach((blog, index) => { %>
                <div class="col-md-4 mb-4">
                  <div class="card shadow-sm">
                    
                    <!-- Blog Image -->
                    <img src="<%= blog.image %>" class="card-img-top" alt="<%= blog.title %>" style="height: 200px; object-fit: contain;">

                    <div class="card-body">
                      <h5 class="card-title"><strong class="text-dark">Blog Title</strong> : <%= blog.title %></h5>
                      <p class="card-text">
                        <strong>Category :</strong> <%= blog.category %>
                      </p>

                      <div class="d-flex justify-content-between">
                        <a href="/delete-blog/<%= blog.id %>" class="btn btn-danger btn-sm">
                          Delete
                        </a>

                        <a href="/update-blog/<%= blog.id %>" class="btn btn-warning btn-sm">
                          Update
                        </a>
                      </div>
                    </div>

                  </div>
                </div>
              <% }) %>
            </div>
          </div>
          <!-- ============================================================== -->
          <!-- End PAge Content -->
          <!-- ============================================================== -->
          <!-- ============================================================== -->
          <!-- Right sidebar -->
          <!-- ============================================================== -->
          <!-- .right-sidebar -->
          <!-- ============================================================== -->
          <!-- End Right sidebar -->
          <!-- ============================================================== -->
        </div>
        <!-- ============================================================== -->
        <!-- End Container fluid  -->
        <!-- ============================================================== -->
        <!-- ============================================================== -->
        <!-- footer -->
        <!-- ============================================================== -->
<%- include('../partials/footer.ejs') %>